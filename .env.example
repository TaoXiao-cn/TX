# 复制为 .env（本地）或 .env.prod（服务器）后按需修改；切勿提交真实密钥

# API
PORT=8787
DATABASE_URL=postgresql://progress:progress@localhost:5432/progress
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# S3 兼容存储
# - 本地 docker-compose 默认 adobe/s3mock
# - 腾讯云 COS（生产）：改 endpoint / region / 密钥 / 桶名，并关闭 path-style
#   文档：https://cloud.tencent.com/document/product/436/37421
#   示例（广州；桶名须为「名称-APPID」）：
#     S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
#     S3_REGION=ap-guangzhou
#     S3_ACCESS_KEY_ID=<腾讯云 SecretId，勿提交>
#     S3_SECRET_ACCESS_KEY=<腾讯云 SecretKey，勿提交>
#     S3_BUCKET=<bucket>-<APPID>
#     S3_FORCE_PATH_STYLE=false
#     S3_PUBLIC_URL=https://<bucket>-<APPID>.cos.ap-guangzhou.myqcloud.com
#   注意：2024-01-01 后新建桶不支持 path-style，生产务必 S3_FORCE_PATH_STYLE=false
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=localsecret
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true
# s3mock 的对象 URL 形态；若换 MinIO 可改为 http://localhost:9000/attachments
S3_PUBLIC_URL=http://localhost:9000/attachments

# 前端（Vite）
# 本地开发：
VITE_API_BASE_URL=http://localhost:8787
# 生产（docker-compose.prod.yml + Nginx 同源反代）：构建参数可留空
# VITE_API_BASE_URL=
# 若前后端不同源，则填公网 API 根地址，例如：
# VITE_API_BASE_URL=http://YOUR_PUBLIC_IP
