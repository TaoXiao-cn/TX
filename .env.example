# 复制为 .env 后按需修改；切勿提交真实密钥

# API
PORT=8787
DATABASE_URL=postgresql://progress:progress@localhost:5432/progress
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# S3 兼容存储（本地 docker-compose 默认 adobe/s3mock；也可换 MinIO / 云厂商）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=localsecret
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true
# s3mock 的对象 URL 形态；若换 MinIO 可改为 http://localhost:9000/attachments
S3_PUBLIC_URL=http://localhost:9000/attachments

# 前端（Vite）
VITE_API_BASE_URL=http://localhost:8787
